{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/styles.css", "dest": "/server.py" },
    { "src": "/app.js", "dest": "/server.py" },
    { "src": "/services.js", "dest": "/server.py" },
    { "src": "/api/(.*)", "dest": "/server.py" },
    { "src": "/(.*)", "dest": "/server.py" }
  ]
}
